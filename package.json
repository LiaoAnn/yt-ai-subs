{
  "name": "yt-ai-subs",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that transcribes (and optionally translates) YouTube audio a few chunks ahead of the playhead.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.ts --watch",
    "build": "node scripts/build.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
